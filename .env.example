# Todo server configuration
PORT=4445
# MAX_SCROLLBACK=131072

# Task execution agent for xterm task sessions: "claude", "codex", or "pi"
TASK_AGENT=claude
# Comma-separated subset of detected agents to expose for task assignment.
# Empty / unset = expose all detected agents.
# AVAILABLE_AGENTS=claude,codex,pi

# Claude model to use for CLI invocations (e.g. opusplan, sonnet, haiku)
CLAUDE_MODEL=opusplan

# Optional Codex model override (leave empty to use your Codex CLI default)
# CODEX_MODEL=

# Storage backend: "api" (remote server) is the only supported value — the local
# TODO.md file backend is retired. Left unset or "file" here still boots, but
# coerces to "api" with a startup warning.
TASK_BACKEND=api

# Remote API settings (only used when TASK_BACKEND=api)
API_BASE_URL=
API_TOKEN=
API_PROJECT_ID=

# User identification (set on first startup)
USER_NAME=
USER_ID=1

# Device identification (set by CLI setup)
DEVICE_ID=
DEVICE_NAME=

# Show AI token usage stats in UI (set to true to enable)
# SHOW_AI_STATS=true

# Hook plumbing — not a Task App config, but referenced by the installed
# .claude/settings.json PreToolUse ExitPlanMode hook. Task App exports this
# at session start so plan captures land under the owning task:
#   ~/.claude/plans/${TIPATASK_TASK_ID:-plan}.md
# Defaults to "plan" when unset.
# TIPATASK_TASK_ID=

# Objective chat auto-retry on Claude CLI stream idle / SDK errors.
# OBJECTIVE_STREAM_IDLE_MS — kill + retry if no stream data arrives within N ms (default 60000).
# OBJECTIVE_MAX_RETRIES — max silent retries per turn before surfacing objective-error (default 2).
# OBJECTIVE_RETRY_BACKOFF_MS — base backoff, doubled per attempt (default 250).
# OBJECTIVE_TURN_MAX_MS — hard wall-clock per user turn across all retries (default 600000).
# OBJECTIVE_EFFORT — Claude CLI --effort level for objective spawns: low|medium|high|xhigh|max (default medium).
#   Lower = faster response. "medium" keeps task-description quality acceptable at much lower latency than high/xhigh.
# OBJECTIVE_STREAM_IDLE_MS=60000
# OBJECTIVE_MAX_RETRIES=2
# OBJECTIVE_RETRY_BACKOFF_MS=250
# OBJECTIVE_TURN_MAX_MS=600000
# OBJECTIVE_EFFORT=medium
OBJECTIVE_TIMING_ENABLED=false

# Objective-chat LLM provider: "claude" (default), "gemini" (Google Gemini CLI), or "pi" (pi.dev via OpenRouter).
# spec-chat always uses Claude regardless of this value. Restart server to apply.
OBJECTIVE_PROVIDER=claude
# GEMINI_MODEL=gemini-2.5-flash   # Gemini model name when OBJECTIVE_PROVIDER=gemini
# PI_MODEL=openrouter/anthropic/claude-3.5-sonnet  # Pi model when OBJECTIVE_PROVIDER=pi (OpenRouter model path)
# OPENROUTER_API_KEY=sk-or-v1-...  # Per-project OpenRouter key injected into Pi spawns; also honoured by scripts/setup-pi-auth.js
# PI_BIN=/path/to/pi  # Pi is bundled as an npm dependency and resolved automatically via
                       # bin/pi after `npm install` — this only overrides that bundled copy.

# Killswitch: disable all prompt-caching, prewarming, hook memoization,
# tag/grep bundle injection, slow-turn compression, and efficiency analysis.
# Set true for plain Claude/Codex/Pi CLI prompt exchange (debug/baseline only).
# SIMPLE_MODE=false
